# Salin ke .env untuk lokal atau isi sebagai environment variables pada hosting.
PORT=3000

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET
SUPABASE_STORAGE_BUCKET=attendance-photos

# Opsional: batasi origin web Flutter, contoh https://group-app.example
# CORS_ORIGIN=*
